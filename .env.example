# Copie para .env e substitua pelo IP LAN e porta reais do Express, incluindo /api.
# Endereço abaixo é ilustrativo. No celular, localhost aponta para o aparelho.
# EXPO_PUBLIC é público: não inclua senhas, tokens ou JWT_SECRET.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api

# Autenticação: "api" usa o backend JWT; "mock" é exclusivo de __DEV__.
# Não configure "mock" em ambientes de produção.
EXPO_PUBLIC_AUTH_MODE=api
